# Build stage
FROM node:20-alpine AS builder

WORKDIR /app

# Install specific PNPM version to match your local one
RUN npm install -g pnpm@9.7.1

# Copy package files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY backend/package.json ./backend/
COPY frontend/ui/package.json ./frontend/ui/
COPY clients/package.json ./clients/
COPY libraries/base/package.json ./libraries/base/

# Install dependencies
RUN pnpm install --frozen-lockfile --ignore-scripts

# Copy source code
COPY . .

# Build the applications
# Build shared library first
RUN pnpm --filter @iWatchFootball/base-tools build
# Build the backend
RUN pnpm --filter @iWatchFootball/api build
# Build the frontend
RUN pnpm --filter @iWatchFootball/ui build

# Frontend production stage with Nginx
FROM nginx:alpine AS frontend-production

# Copy the built frontend assets to Nginx serve directory
COPY --from=builder /app/frontend/ui/dist /usr/share/nginx/html

EXPOSE 8080

# Backend production stage
FROM node:20-alpine AS production

WORKDIR /app

# Install specific PNPM version to match your local one
RUN npm install -g pnpm@9.7.1

# Copy workspace configuration files first
COPY --from=builder /app/package.json /app/pnpm-lock.yaml /app/pnpm-workspace.yaml ./

# Copy package.json files for all workspace packages
COPY --from=builder /app/backend/package.json ./backend/
COPY --from=builder /app/clients/package.json ./clients/
COPY --from=builder /app/libraries/base/package.json ./libraries/base/

# Copy built/dist files
COPY --from=builder /app/backend/dist ./backend/dist
COPY --from=builder /app/clients ./clients
COPY --from=builder /app/libraries ./libraries

# Install production dependencies
# This will properly set up workspace links for @iWatchFootball packages
RUN pnpm install --prod --frozen-lockfile --ignore-scripts

# Verify workspace packages are linked (for debugging)
RUN ls -la node_modules/@iWatchFootball/ || echo "Workspace packages not found in node_modules"

# Create non-root user and set ownership BEFORE switching user
RUN addgroup -S nodejs && adduser -S nestjs -G nodejs
RUN chown -R nestjs:nodejs /app
USER nestjs

# Expose Cloud Run default port
EXPOSE 8080

# Run the backend service
CMD ["node", "backend/dist/src/main.js"]
