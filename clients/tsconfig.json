{
	"extends": "../tsconfig.json",
	"include": [
		"client-instance.ts",
		"controllers/**/*.ts"
	],
	"exclude": [
		"node_modules",
		"dist",
		"test",
		"**/*spec.ts"
	],
	"references": [
		{
			"path": "../libraries/base"
		}
	],
	"compilerOptions": {
		"baseUrl": "./",
		"rootDir": ".",
		"outDir": "./dist",
		"skipLibCheck": true,
		"noImplicitAny": false,
		"module": "ESNext",
		"moduleResolution": "node"
	}
}
