{
	"extends": "../tsconfig.json",
	"include": [
		"package.json",
		"tsconfig.json",
		"controllers/**/*"
	],
	"exclude": [
		"node_modules",
		"dist",
		"test",
		"**/*spec.ts"
	],
	"references": [
		{
			"path": "../libraries/base"
		},
		{
			"path": "../clients"
		}
	],
	"compilerOptions": {
		"baseUrl": "./",
		"skipLibCheck": true,
		"noImplicitAny": false
	}
}
