{
	"extends": "../tsconfig.json",
	"include": [
		"package.json",
		"tsconfig.json",
		"client-instance.ts",
		"controllers/**/*"
	],
	"exclude": [
		"node_modules",
		"dist",
		"test",
		"**/*spec.ts"
	],
	"references": [
		{
			"path": "../libraries/base"
		}
	],
	"compilerOptions": {
		"baseUrl": "./",
		"skipLibCheck": true,
		"noImplicitAny": false,
		"module": "ESNext",
		"moduleResolution": "node"
	}
}
